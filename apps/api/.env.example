# Copy to .env for local development. Never commit .env.

# Railway Postgres connection string. Leave empty to use the embedded local Postgres (PGlite) in ./.pglite
DATABASE_URL=

PORT=4000

# Long random string used to sign Lasan session tokens (JWT). Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string

# Comma-separated origins allowed to call the API (website, admin console, Expo web)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8081

# Firebase project used for phone OTP. The API only needs the project ID to verify ID tokens.
FIREBASE_PROJECT_ID=

# Dev login: accepts OTP 123456 for any phone without Firebase. MUST be false in production.
AUTH_DEV_MODE=true

# First admin account, created by `npm run db:seed`
ADMIN_EMAIL=admin@lasanfamily.in
ADMIN_PASSWORD=change-me-now
