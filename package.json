{
  "name": "lasan-family",
  "private": true,
  "description": "Lasan Family: trusted maids and home cooks for women across Andhra Pradesh and Telangana",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w @lasan/web",
    "dev:admin": "npm run dev -w @lasan/admin",
    "dev:api": "npm run dev -w @lasan/api",
    "dev:mobile": "npm run start -w @lasan/mobile",
    "db:generate": "npm run db:generate -w @lasan/api",
    "db:migrate": "npm run db:migrate -w @lasan/api",
    "db:seed": "npm run db:seed -w @lasan/api",
    "build": "npm run build -w @lasan/api && npm run build -w @lasan/web && npm run build -w @lasan/admin",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "engines": {
    "node": ">=22"
  }
}
