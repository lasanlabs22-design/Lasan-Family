{
  "name": "@lasan/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env src/db/seed.ts",
    "db:reset": "tsx --env-file-if-exists=.env src/db/seed.ts --reset"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "@hono/node-server": "^2.1.5",
    "@lasan/shared": "*",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.4",
    "firebase-admin": "^14.5.0",
    "hono": "^4.13.14",
    "jose": "^6.2.14",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
